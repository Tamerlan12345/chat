# Dependencies
node_modules/

# Runtime data — real employee data, password hashes, chat history, uploads, backups
server/data/

# Server-generated local secrets
server/data/.jwt_secret

# Настройки развёртывания: пароль к базе учётных записей, секрет подписи
# токенов, начальный пароль администратора. В репозитории им не место —
# образец лежит в .env.example.
.env
.env.*
!.env.example

# Build output
desktop/dist/
desktop/release/
desktop/electron_debug.log

# Installer binaries (built artifacts, not source)
installer/*.exe
installer/*.blockmap

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db

# Ключи и сертификаты подписи — только в защищённом хранилище, не в репозитории
*.pfx
*.p12
*.pem
*.key

# Промежуточные результаты сборки установщика
installer/win-unpacked/
installer/app/
*.zip

# Сборка презентации
desktop/presentation/dist-app/
desktop/presentation/dist-deck/

# SDD workspaces
.superpowers/

# Рабочие копии агентов
.claude/worktrees/
