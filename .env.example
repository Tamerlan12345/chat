# Образец настроек развёртывания. Скопируйте в .env и заполните.
# Файл .env в репозиторий не попадает — см. .gitignore.

# ── Обязательное ────────────────────────────────────────────────────────────

# Пароль к базе учётных записей. Задайте длинную случайную строку, например:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# Пароль первого входа администратора. Служит один раз: при первом входе
# система потребует сменить его. И он сам, и новый проходят политику пароля:
# не короче 8 символов, не из списка распространённых, не равен логину
# (admin) — иначе сервер на пустой базе не стартует и назовёт причину.
INITIAL_ADMIN_PASSWORD=

# Секрет подписи токенов, не короче 32 байт. Если не задан, сервер сгенерирует его сам и
# сохранит в томе данных. Задавайте явно, только если нужно, чтобы секрет
# пережил потерю тома, — и тогда он тоже должен быть длинным и случайным.
# JWT_SECRET=

# ── Хранилище учётных записей вне Docker ────────────────────────────────────
# В docker-compose адрес базы собирается автоматически. Эти переменные нужны,
# когда сервер запускается без compose — например, на Railway.
#
# DATABASE_URL=postgresql://пользователь:пароль@узел:5432/база
#
# Режим TLS до базы. По умолчанию: проверяемый TLS для внешних узлов, без TLS
# для localhost и внутренних адресов (.railway.internal, 10.*, 192.168.*).
#   disable   — без шифрования (только частная сеть)
#   no-verify — шифрование без проверки сертификата (подмену узла не заметит)
# DATABASE_SSL=
# DATABASE_CA_CERT=

# ── Ограничение доступа по адресу ───────────────────────────────────────────
# Список адресов и подсетей, которым вообще разрешено дотянуться до сервера.
# Пусто — открыто для всех; годится только для сети внутри офиса. Именно это
# останавливает того, кто раздобыл установщик и пытается войти с домашнего
# компьютера с настоящим логином и паролем.
# ALLOWED_CLIENT_IPS=87.255.197.10,192.168.10.0/24

# Адрес обратного прокси, если он стоит впереди ради HTTPS. Пока сервер
# доступен напрямую — оставьте пустым, иначе заголовок X-Forwarded-For можно
# подделать и обойти список выше.
# TRUSTED_PROXY_IPS=

# Разрешить открывать интерфейс обычным браузером, а не только приложением.
# ALLOW_BROWSER_ACCESS=false

# Сайты, которым разрешено обращаться к API из браузера (CORS). Интерфейс
# загружается с этого же сервера и в разрешении не нуждается, поэтому по
# умолчанию список пуст. Нужен только для разработки, когда интерфейс
# запущен отдельно (vite на localhost:5173).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Восстановление доступа ──────────────────────────────────────────────────
# Аварийный сброс пароля администратора. Срабатывает один раз на каждое новое
# значение. ПОСЛЕ ВХОДА УДАЛИТЕ ЭТУ ПЕРЕМЕННУЮ: пока она задана, пароль
# администратора известен всем, у кого есть доступ к настройкам развёртывания.
# ADMIN_PASSWORD_RESET=
# ADMIN_PASSWORD_RESET_USER=admin

# Если хранилище учётных записей пустое, а переписка уже есть, сервер
# откажется запускаться: так выглядит потерянная база сотрудников, и молча
# создать поверх неё администратора с паролем по умолчанию нельзя. Флаг нужен
# только для осознанного сброса всех учётных записей.
# IDENTITY_ALLOW_EMPTY_BOOTSTRAP=true

# Перенос учётных записей из резервного файла (data/identity.db,
# data/pre-identity-split.db) в пустое хранилище больше не происходит сам по
# себе — только с этим явным флагом. Без него сервер лишь предупреждает в
# журнале и переходит к чистой установке (или к отказу подняться, см. выше).
# Подробности и порядок поиска источника — docs/identity-store.md.
# IDENTITY_AUTO_IMPORT=true

# ── Прочее ──────────────────────────────────────────────────────────────────
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=14
# PG_POOL_MAX=10

# ── Защита от подбора пароля и пределы частоты ──────────────────────────────
# Нечисловое, нулевое или вне диапазона значение сервер заменяет значением по
# умолчанию и предупреждает в журнале — опечатка не выключает защиту.
#
# Неудачных входов с одного адреса под одним логином, после которых эта пара
# адрес+логин ждёт LOGIN_LOCKOUT_MINUTES минут (1–1000 и 1–1440).
# LOGIN_MAX_FAILED_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15
#
# Суточный предел неверных проверок пароля на ОДНУ учётную запись (требование
# владельца): за скользящие 24 часа не больше U+F+P ≈ 20 догадок, три раздельные
# корзины, чтобы одна не съедала другую:
#   LOGIN_DAILY_FAILURES_UNFAMILIAR — неверный пароль при входе с адреса, откуда
#     этот сотрудник ещё не входил (типичный внешний подбор), по умолчанию 5;
#   LOGIN_DAILY_FAILURES_FAMILIAR — при входе со «знакомого» адреса (офис, дом
#     сотрудника), по умолчанию 10;
#   PASSWORD_CHANGE_DAILY_FAILURES — неверный текущий пароль при смене пароля,
#     по умолчанию 5.
# Исчерпанная корзина отклоняет вход (или смену) БЕЗ проверки пароля — ответ 429
# даже для верного пароля — пока самая старая неудача не выйдет из окна 24 ч или
# администратор не сбросит сотруднику пароль. Считаются только настоящие
# неверные пароли (перегрузка сервера — нет). Журнал неудач хранится в базе
# учётных записей (таблица login_failure_log) и переживает перезапуск/передеплой.
# «Стук» привязанного устройства этим пределом не ограничивается. Удачный вход
# снимает только свою корзину (вход из офиса не обнуляет U), самостоятельная
# смена пароля — только P; сброс пароля администратором — все три.
# 0 — корзина выключена (не рекомендуется); мусор/отрицательное — умолчание.
# LOGIN_DAILY_FAILURES_UNFAMILIAR=5
# LOGIN_DAILY_FAILURES_FAMILIAR=10
# PASSWORD_CHANGE_DAILY_FAILURES=5
#
# Потолок персональной задержки источника (вторичный слой, 1–3600 с): растущая
# пауза между попытками одного незнакомого адреса, включается только при
# подборе с нескольких адресов (неудач больше LOGIN_MAX_FAILED_ATTEMPTS). При
# стандартных пределах обычно не успевает сработать — суточная корзина
# отклоняет раньше; оживает, если корзину ослабить или выключить.
# LOGIN_ACCOUNT_MAX_DELAY_SECONDS=60
#
# Сколько паролей хэшируется одновременно (scrypt, ~128 МиБ каждый), 1–16.
# PASSWORD_HASH_CONCURRENCY=2
#
# Одновременных проверок пароля (scrypt) с одного адреса. Сверх предела — 503
# с Retry-After (не неудача), клиент повторяет; так один адрес не занимает всю
# очередь хэшей. Для адреса офиса (знакомого хотя бы одной учётной записи) —
# LOGIN_INFLIGHT_PER_IP (щедро); для адреса, незнакомого никому (типичный
# атакующий), — LOGIN_INFLIGHT_UNFAMILIAR (жёстко мало).
# LOGIN_INFLIGHT_PER_IP=20
# LOGIN_INFLIGHT_UNFAMILIAR=3
#
# Запросов к API без входа с одного адреса (сети /64 для IPv6) в минуту.
# Дешёвые публичные GET (сведения о сервере, /health) под него не попадают —
# иначе утренний запуск офиса за одним NAT упирался бы в него. 0 — выключено;
# иначе не меньше 600 (значения 1–599 откатываются к умолчанию).
# ANON_RATE_LIMIT_PER_MINUTE=12000
#
# Мегабайт вложений, которые один сотрудник может загрузить за час. 0 — без предела.
# UPLOAD_MAX_MB_PER_HOUR=2048
#
# Ниже этого запаса свободного места (МБ) на томе загрузок файл не принимается
# (507): чтобы запись базы переписки в тот же том не оборвалась. 0 — выключить.
# UPLOAD_MIN_FREE_DISK_MB=1024
#
# Одновременных WebSocket-соединений с одного адреса (сети /64). Для крупного
# офиса за одним NAT — с запасом.
# WS_MAX_SOCKETS_PER_IP=2000
#
# Запросов автообновления с одного адреса (сети /64) в минуту. У каждой
# установки свой предел 120/мин по её install-id; это — высокий потолок на
# адрес, чтобы вместить весь офис за одним NAT.
# UPDATES_MAX_REQ_PER_MIN_PER_IP=6000

# ── Защита и мониторинг ─────────────────────────────────────────────────────
# Ключ шифрования резервных копий (не короче 32 байт). Храните отдельно от
# сервера: без него копии не расшифровать (server/scripts/decrypt-backup.js).
# BACKUP_ENCRYPTION_KEY=
#
# Отдельный ключ цепочки журнала аудита. Без него ключ выводится из JWT_SECRET,
# и смена JWT_SECRET делает старую часть журнала непроверяемой.
# AUDIT_HMAC_KEY=
#
# Срок жизни токена в часах (по умолчанию 12; клиент продлевает сам) и
# максимальная длительность сессии без повторного входа в днях (по умолчанию 30).
# TOKEN_TTL_HOURS=12
# SESSION_MAX_DAYS=30
#
# Срок жизни секрета устройства («вход без пароля» на привязанном рабочем
# компьютере) в днях — не подтверждённый повторным входом по паролю дольше
# этого срока секрет перестаёт действовать сам. Если задаёте SESSION_MAX_DAYS
# короче этого значения — это штатно: сервер сам просит пароль заново, как
# только заявка старше SESSION_MAX_DAYS, не дожидаясь TTL секрета. Подробнее —
# docs/выпуск-2026-10-безопасность.md, раздел про эти две переменные.
# DEVICE_SECRET_TTL_DAYS=30
#
# Токены прежнего (миллисекундного) формата принимаются только до этой даты,
# даже если их срок ещё не истёк. Нераспознаваемое значение сервер сам
# заменяет датой по умолчанию и предупреждает в журнале.
# LEGACY_TOKEN_CUTOFF=2026-10-15T00:00:00Z
#
# HTTPS обеспечивает прокси перед сервером, а TRUSTED_PROXY_IPS не задан:
# отметьте явно, чтобы самопроверка не предупреждала.
# HTTPS_TERMINATED=true
#
# Как часто проверять целостность журнала и свежесть копий (часов, по умолчанию 6).
# SECURITY_CHECK_INTERVAL_HOURS=6

# ── Автообновление настольного клиента ──────────────────────────────────────
# Подробное описание механизма, каналов и политики версий — docs/автообновление.md.
# Здесь — только сами переменные окружения.
#
# Куда сервер кладёт и откуда раздаёт релизы (установщики, latest.yml).
# UPDATES_DIR=./data/updates
#
# Жёсткий выключатель на уровне развёртывания: консоль администратора его не
# переопределяет — угнанная учётная запись не включит раздачу обратно.
# UPDATES_DISABLED=false
#
# Сверх этого числа одновременных скачиваний — 503 и Retry-After.
# UPDATES_MAX_CONCURRENT_DOWNLOADS=20
#
# Предел размера одного файла релиза (МБ).
# UPDATES_MAX_FILE_MB=600

# ── Push-уведомления мобильных приложений (iOS / Android) ───────────────────
# Необязательно. Пока ничего не задано, push выключен: сервер пишет об этом
# одну строку в журнал при запуске, чат и звонки работают как раньше, а
# приложения узнают о новом при открытии. Через Google и Apple уходят ТОЛЬКО
# идентификаторы (id переписки, сообщения, звонящего) — ни текста, ни имён
# (mobile/contracts/push.md). Пошаговая настройка — mobile/dev/README.md,
# раздел «Push-уведомления».
#
# Ключи не кладите в репозиторий и в этот файл: только в секреты платформы
# (Railway Variables / Docker secrets) или в файл вне каталога проекта.
#
# Android (Firebase Cloud Messaging HTTP v1): JSON сервисного аккаунта Firebase
# — путём к файлу или целиком строкой (одно из двух).
# PUSH_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
# PUSH_FCM_SERVICE_ACCOUNT_JSON=
#
# iOS (APNs, ключ .p8 из Apple Developer → Keys, с включённым APNs): путём к
# файлу или PEM-строкой (переводы строк можно записать как \n).
# PUSH_APNS_KEY_FILE=/run/secrets/AuthKey_XXXXXXXXXX.p8
# PUSH_APNS_KEY=
# Key ID ключа (10 символов), Team ID команды (10 символов) и bundle id
# приложения; звонки уходят на <bundle id>.voip (PushKit).
# PUSH_APNS_KEY_ID=
# PUSH_APNS_TEAM_ID=
# PUSH_APNS_BUNDLE_ID=
#
# Пределы (по умолчанию): токенов на сотрудника, одновременных отправок,
# длина очереди, попыток доставки одного уведомления.
# PUSH_MAX_TOKENS_PER_USER=10
# PUSH_CONCURRENCY=8
# PUSH_QUEUE_MAX=10000
# PUSH_MAX_ATTEMPTS=4
