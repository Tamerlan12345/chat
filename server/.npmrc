# Зависимости сервера не нуждаются в установочных скриптах (в package-lock.json
# нет ни одного hasInstallScript; sharp 0.35.x ставит готовые сборки libvips
# пакетами @img/* без postinstall). Политика по умолчанию — запрет: новый
# пакет со скриптом установки не выполнит его молча.
ignore-scripts=true
