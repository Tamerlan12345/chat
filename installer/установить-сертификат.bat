@echo off
chcp 65001 >nul
title Установка корпоративного сертификата Centras

echo ================================================================
echo   Установка сертификата, которым подписаны дистрибутивы
echo ================================================================
echo.
echo Без него Windows не может проверить, кто выпустил приложение,
echo и показывает предупреждение о неизвестном издателе.
echo.
echo Запустите этот файл от имени администратора, чтобы сертификат
echo подошёл всем пользователям компьютера. Без этого он установится
echo только для вас - приложение всё равно запустится.
echo.

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0установить-сертификат.ps1"

echo.
pause
