{
  "name": "mychat-desktop",
  "version": "1.1.0",
  "description": "CentyChat Desktop Application Client",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "vite build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:nsis": "npm run build && electron-builder --win nsis --publish never",
    "test": "node --test --test-concurrency=1 test/remote-input.test.js test/rd-file-name.test.js test/audio-relay.test.mjs test/remote-pointer.test.mjs test/person-name.test.mjs test/avatar.test.mjs test/wake.test.mjs test/theme.test.mjs test/attachments.test.mjs test/admin-access.test.mjs test/key-codes.test.js test/display-map.test.js test/main-guards.test.js test/autostart.test.js test/rd-session.test.mjs test/call-lifecycle.test.mjs test/client-hardening.test.js test/security-labels.test.mjs test/build-config.test.js test/sha512-powershell.test.js test/download-guard.test.js test/file-policy.test.mjs test/message-actions.test.mjs test/installer-scripts.test.js test/installer-policy.test.js test/installer-nsh.test.js test/copy-install.test.js test/publish-update.test.js test/client-config.test.js test/update-policy.test.js test/update-verify.test.js test/updater.test.js test/update-status.test.mjs test/update-admin.test.mjs test/login-retry.test.mjs test/multi-device.test.mjs test/live-events.test.mjs test/registration-admin.test.mjs",
    "sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-and-publish.ps1",
    "release": "npm run dist && npm run sign",
    "publish:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-update.ps1"
  },
  "keywords": [
    "centychat",
    "desktop",
    "electron",
    "corporate-chat",
    "enterprise"
  ],
  "author": "Centras Insurance (АО Сентрас Иншуранс)",
  "license": "ISC",
  "build": {
    "appId": "com.openmychat.desktop",
    "productName": "CentyChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "build/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/centychat/",
        "channel": "latest"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExts": [
        ".dll"
      ],
      "signtoolOptions": {
        "sign": "./scripts/sign-windows.js",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "publisherName": [
          "Centras Insurance (АО Сентрас Иншуранс)"
        ]
      },
      "verifyUpdateCodeSignature": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CentyChat",
      "runAfterFinish": true,
      "perMachine": false,
      "uninstallDisplayName": "CentyChat (Сентрас Иншуранс)",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CentyChat-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CentyChat-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.17.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "^5.1.0"
    }
  }
}
