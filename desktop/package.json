{
  "name": "mychat-desktop",
  "version": "1.0.0",
  "description": "OpenMyChat Enterprise Desktop Application Client",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "test": "node --test --test-concurrency=1 test/remote-input.test.js test/rd-file-name.test.js test/audio-relay.test.mjs test/remote-pointer.test.mjs test/person-name.test.mjs test/avatar.test.mjs test/wake.test.mjs test/theme.test.mjs test/admin-access.test.mjs test/key-codes.test.js test/display-map.test.js test/main-guards.test.js test/autostart.test.js test/rd-session.test.mjs test/call-lifecycle.test.mjs",
    "sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-and-publish.ps1",
    "release": "npm run dist && npm run sign"
  },
  "keywords": [
    "mychat",
    "desktop",
    "electron",
    "corporate-chat",
    "enterprise"
  ],
  "author": "OpenMyChat Enterprise",
  "license": "ISC",
  "build": {
    "appId": "com.openmychat.desktop",
    "productName": "OpenMyChat Enterprise",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenMyChat Enterprise",
      "runAfterFinish": true,
      "perMachine": false,
      "uninstallDisplayName": "OpenMyChat Enterprise (Сентрас Иншуранс)",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
