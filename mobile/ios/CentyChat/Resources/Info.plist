<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>ru</string>
    <key>CFBundleDisplayName</key>
    <string>CentyChat</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>kz.centras.centychat</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <!-- The build number comes from the build settings (CURRENT_PROJECT_VERSION), raised per upload. -->
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- Read only by DEBUG builds (ServerEnvironment); Release compiles the production URL in. -->
    <key>CentyChatServerURL</key>
    <string>$(CENTYCHAT_SERVER_URL)</string>
    
    <!-- Export compliance: only the system's HTTPS/TLS, no own encryption (answered in the build). -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Privacy Descriptions for App Store Review: only for what the app uses. PhotosPicker needs no
         permission; the app has no camera. Saving to Photos happens from the share sheet. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>CentyChat требует доступ к микрофону для проведения корпоративных защищённых голосовых звонков между сотрудниками.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Чтобы сохранить фото или видео из переписки в медиатеку, когда вы выбираете «Сохранить».</string>

    <!-- Background Modes (Guideline 2.5.4 compliant: voip removed until CallKit integration):
         audio — calls; remote-notification — silent pushes (read on another device, decision P);
         fetch — the background flush of unsent messages (BGAppRefreshTask). -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>kz.centras.centychat.delivery-flush</string>
    </array>
    
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- iPad: все четыре ориентации обязательны для многозадачности (Split View / Slide Over) -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
